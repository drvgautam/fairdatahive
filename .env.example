DATABASE_URL=postgresql+asyncpg://fairdatahive:fairdatahive@postgres:5432/fairdatahive

# --- Object storage (S3 API; RustFS in compose, also MinIO/AWS S3/Ceph) ---
# Legacy MINIO_* names are still accepted for one transition release; S3_* wins
# when both are set and a warning is logged.
S3_ENDPOINT=http://rustfs:9000
# Browser-facing URL for presigned downloads (host port from docker-compose)
S3_PUBLIC_ENDPOINT=http://localhost:9002
# Application credential. Local compose reuses the RustFS root key below;
# in production create a restricted, bucket-scoped key and keep root separate.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=fairdatahive-catalog
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
# Entrypoint creates the bucket if missing (idempotent). Set false when the
# bucket is managed externally; access is still verified at startup.
PROVISION_STORAGE=true

# RustFS server root credentials (compose variable substitution only).
RUSTFS_ROOT_ACCESS_KEY=rustfsadmin
RUSTFS_ROOT_SECRET_KEY=rustfsadmin
# Optional: override the pinned image (default digest lives in docker-compose.yml)
# RUSTFS_IMAGE=rustfs/rustfs:1.0.1@sha256:...

KEYCLOAK_URL=http://auth:8080
KEYCLOAK_REALM=fairdatahive
# Optional: require JWT aud to match this client (recommended in production)
KEYCLOAK_CLIENT_ID=
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost:8002

# React UI dev (Vite on 5173) and built UI at /ui/
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8002

# Set false on internet-facing deployments (see SECURITY.md)
ENABLE_OPENAPI=true
ENABLE_METRICS=true

# Local development only — bypasses JWT. MUST be false in production.
DEV_AUTH_ENABLED=false
DEV_AUTH_SUB=dev-user
DEV_AUTH_NAME=Development User

EMBEDDING_MODEL=multi-qa-mpnet-base-dot-v1
FAIR_SCORE_PUBLISH_THRESHOLD=0.4
PRESIGNED_URL_EXPIRY_SECONDS=3600
ACCESS_REQUEST_EXPIRY_DAYS=30
MAX_UPLOAD_SIZE_MB=500

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fairdatahive.local

DATACITE_REPO_ID=
DATACITE_PASSWORD=
DATACITE_DOI_PREFIX=
DATACITE_API_URL=https://api.test.datacite.org
